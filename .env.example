# Set these in Vercel Project Settings > Environment Variables.
NODE_ENV=production
# Neon integration injects DATABASE_URL when you connect the database to this project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_EMAIL=your-admin-email@example.com
# Generate locally with: npm run create-admin-hash
ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_salt$replace_with_generated_hash
