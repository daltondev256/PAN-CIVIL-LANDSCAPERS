# Set these in your hosting provider's environment settings. Never commit real values.
NODE_ENV=production
PORT=5000
ADMIN_EMAIL=admin@example.com
# Generate with: npm run create-admin-hash
ADMIN_PASSWORD_HASH=scrypt$replace_with_generated_salt$replace_with_generated_hash
# Optional: comma-separated trusted frontend origins when frontend and API use different origins.
ALLOWED_ORIGINS=
